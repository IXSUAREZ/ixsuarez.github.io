+/* Neumorphic content material, rebuilt from the verified current source.
+   PAVE colors, risk tapes, toggles, gauges and printed summary are semantic. */
+@media screen {
+  html[data-gold-mode] body.flightrisk-view #root :is(.border.bg-white,.border.bg-surface-card,.border.bg-alt,[data-slot="card"]),
