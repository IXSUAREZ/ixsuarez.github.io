+    background-color:var(--av-neu-well,var(--g-well));
+  }
+  html[data-gold-mode] body.flightrisk-view .fr-confirm-secondary {
+    background:var(--av-neu-surface,var(--g-surface));border-radius:10px;
+    box-shadow:var(--av-neu-shadow-sm,var(--g-shadow));
+  }
+  html[data-gold-mode] body.flightrisk-view .fr-confirm-overlay {
+    backdrop-filter:none;-webkit-backdrop-filter:none;
+  }
+  html[data-gold-mode] body.flightrisk-view #root button:not(:disabled):active,
+  html[data-gold-mode] body.flightrisk-view .fr-confirm-actions button:active {
