+    box-shadow:var(--av-neu-shadow-sm,var(--g-shadow));
+  }
+  html[data-gold-mode] body.flightrisk-view #root :is(input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),select,textarea,.border.bg-surface-soft),
+  html[data-gold-mode] body.flightrisk-view #root [role="radiogroup"].bg-surface-sunken {
+    background:var(--av-neu-surface,var(--g-surface));
+    border-color:var(--g-line);border-radius:10px;
+    box-shadow:var(--av-neu-inset,inset 3px 3px 6px #0002,inset -3px -3px 6px #fff6);
+  }
+  html[data-gold-mode] body.flightrisk-view #root .border.bg-surface-soft>input {
+    background:transparent;box-shadow:none;
+  }
+  html[data-gold-mode] body.flightrisk-view :is(.bg-accent-600,.bg-accent-700,.fr-confirm-primary),
+  html[data-gold-mode] body.flightrisk-view #root [role="radio"][aria-checked="true"] {
+    background:var(--g-gold)!important;color:var(--g-key-ink)!important;
+    border-color:var(--g-edge)!important;border-radius:10px;
+    box-shadow:var(--av-neu-gold-shadow,var(--g-shadow))!important;
+  }
+  html[data-gold-mode] body.flightrisk-view #root [role="radio"][aria-checked="true"]>.absolute {
+    background:transparent;box-shadow:none;border-radius:inherit;
+  }
+  html[data-gold-mode] body.flightrisk-view #root button[role="switch"] {
